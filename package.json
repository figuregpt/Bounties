{
  "name": "bounties",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx src/lib/db/seed.ts",
    "db:reconcile": "dotenv -e .env.local -- tsx scripts/reconcile-bounty-counters.ts",
    "tokens:backfill": "dotenv -e .env.local -- tsx --conditions=react-server scripts/backfill-token-info.ts",
    "smart-accounts:seed": "dotenv -e .env.local -- tsx scripts/seed-smart-accounts.ts",
    "smart-accounts:sync": "dotenv -e .env.local -- tsx scripts/sync-smart-accounts.ts",
    "smart-accounts:refresh": "dotenv -e .env.local -- tsx scripts/refresh-smart-accounts.ts",
    "smart-accounts:backfill-hunters": "dotenv -e .env.local -- tsx scripts/backfill-hunter-counts.ts",
    "worker": "dotenv -e .env.local -- tsx --conditions=react-server src/worker/index.ts",
    "twitter:cost-report": "dotenv -e .env.local -- tsx scripts/twitter-cost-report.ts",
    "treasury:generate": "dotenv -e .env.local -- tsx scripts/generate-treasury.ts",
    "test:attacks": "dotenv -e .env.local -- tsx --conditions=react-server scripts/test-attack-vectors.ts",
    "security:audit": "dotenv -e .env.local -- tsx --conditions=react-server scripts/security-audit.ts"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@hookform/resolvers": "^5.2.2",
    "@solana-program/memo": "^0.11.0",
    "@solana/kit": "^6.9.0",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.100.14",
    "@types/ws": "^8.18.1",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.51.3",
    "wagmi": "^3.6.16",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
