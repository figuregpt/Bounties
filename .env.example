# --- Database (Railway managed Postgres) ----------------------------------
DATABASE_URL=postgresql://user:password@host:5432/bounties

# --- Auth (NextAuth v5 + Twitter OAuth 2.0) -------------------------------
# Create the OAuth 2.0 client at developer.twitter.com. The callback
# URI registered there MUST match:
#   <NEXTAUTH_URL>/api/auth/callback/twitter
# Twitter v2 scopes used: tweet.read users.read offline.access
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# JWT signing key. Generate with: openssl rand -base64 32
# Keep stable across deploys — rotating invalidates all active sessions.
AUTH_SECRET=
# Base URL of the app (dev: http://localhost:3001). NextAuth uses this
# to build the callback URL during OAuth redirects.
NEXTAUTH_URL=http://localhost:3001

# --- Twitter (twitterapi.io) ----------------------------------------------
TWITTER_API_KEY=

# --- bags.fm SDK ----------------------------------------------------------
BAGS_API_KEY=

# --- Solana ---------------------------------------------------------------
# Network the app is talking to. Drives the canonical-token registry
# (mainnet USDC mint vs devnet USDC mint), warning banners, and which
# RPC default to use when SOLANA_RPC_URL is unset.
#
# SOLANA_NETWORK is server-only. NEXT_PUBLIC_SOLANA_NETWORK is the
# client-visible copy — Next.js only inlines NEXT_PUBLIC_* into the
# browser bundle, so the create form's default reward token + the
# devnet banner need this duplicate. Keep both in sync.
SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoint. Public devnet works for early testing but is rate-limited
# and unreliable. For Phase 9A: get a Helius devnet endpoint (free tier
# at helius.dev). For mainnet later: Helius paid / Triton / QuickNode.
#
# Wallet-adapter on the client also needs this URL — the @solana/web3.js
# Connection it instantiates points here. The WebSocket variant is
# derived from the same host with `wss://`.
# Keep both values in sync.
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Treasury wallet — generate with `npm run treasury:generate`.
# Keep the PRIVATE key OUT of git; only set in .env.local + Railway
# secrets. The public key is safe to commit but here for visibility.
TREASURY_WALLET_PUBLIC_KEY=
TREASURY_WALLET_PRIVATE_KEY=

# DEPRECATED: BOUNTIES_TREASURY_ADDRESS was the pre-Phase-9A name for
# TREASURY_WALLET_PUBLIC_KEY. The env helper still falls back to it so
# old deployments don't break, but new deployments should leave this
# unset and use TREASURY_WALLET_PUBLIC_KEY only. Remove from .env.local
# once you've migrated.

# bounties.fm escrow mode: mock | devnet | mainnet.
# Treasury sendReward() + escrow verification both read this.
#   mock     → fake signatures, no on-chain tx (local dev default)
#   devnet   → real tx against the devnet RPC (Phase 9A)
#   mainnet  → real tx against mainnet RPC (Phase 9B+)
BOUNTIES_ESCROW_MODE=mock

# Emergency kill switch — set to `false` to force mock behavior even
# when BOUNTIES_ESCROW_MODE is devnet/mainnet. Required for real txs:
# BOTH ENABLE_REAL_TX=true AND BOUNTIES_ESCROW_MODE in (devnet, mainnet).
ENABLE_REAL_TX=true

# --- Cron (Phase 8) -------------------------------------------------------
# Shared secret between web service and Railway cron services. Required
# in production; set anything locally (`dev`) to exercise endpoints.
CRON_SECRET=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Discord webhook ------------------------------------------------------
# Fire-and-forget announcement when a bounty is launched. Create the
# webhook in your Discord channel: Channel settings → Integrations →
# Webhooks → New Webhook → Copy URL. Leave blank to disable.
DISCORD_BOUNTY_WEBHOOK_URL=
# Optional role to ping with the announcement. Right-click the role in
# Discord (Developer Mode on) → Copy Role ID. Leave blank for no ping.
DISCORD_BOUNTY_PING_ROLE_ID=
